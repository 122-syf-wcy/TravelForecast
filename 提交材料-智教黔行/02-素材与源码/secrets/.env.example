# 智教黔行 · 环境变量配置模板
# -----------------------------------------------------------------
# 使用说明：
#   1. 复制本文件为 secrets/.env：  cp secrets/.env.example secrets/.env
#   2. 把下方的占位符替换为你真实的凭证
#   3. 服务启动脚本会自动加载 secrets/.env
#   4. secrets/.env 已加入 .gitignore，**切勿**提交到版本库
# -----------------------------------------------------------------

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=travel_prediction
DB_USER=root
DB_PASSWORD=<请填写数据库密码>

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT =====
# 生产环境请使用随机 32 字节以上的强密钥
JWT_SECRET=<请填写32+字节随机密钥>

# ===== 阿里云 OSS =====
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_BUCKET=<请填写OSS存储桶名>
OSS_ACCESS_KEY_ID=<请填写阿里云AccessKey ID>
OSS_ACCESS_KEY_SECRET=<请填写阿里云AccessKey Secret>

# ===== 微信小程序 =====
WECHAT_APPID=<请填写微信小程序AppID>
WECHAT_APPSECRET=<请填写微信小程序AppSecret>

# ===== AI 服务 =====
# 阿里 DashScope（通义千问）
DASHSCOPE_API_KEY=<请填写DashScope API Key>
# DeepSeek 大模型
DEEPSEEK_API_KEY=<请填写DeepSeek API Key>

# ===== 高德地图 =====
AMAP_API_KEY=<请填写高德地图Web服务API Key>

# ===== Spring Profile =====
SPRING_PROFILES_ACTIVE=prod
