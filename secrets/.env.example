# ============================================================
# 智教黔行 · 环境变量模板
# 复制此文件为 secrets/.env 并填入真实值
# secrets/.env 已在 .gitignore 中排除，不会被提交
# ============================================================

# -------- 通用 --------
# 当 deploy/start-all.sh 调用 Spring Boot jar 时使用
SPRING_PROFILES_ACTIVE=prod
# 管理控制台/用户端的公开地址（多个用逗号分隔）
APP_FRONTEND_URL=https://travel.dongsiwei.com

# -------- 数据库 --------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travel_prediction
DB_USER=root
DB_PASSWORD=

# -------- Redis --------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------- JWT --------
# 必填：生产环境至少 32 字符长度
JWT_SECRET=
# Token 过期时间（毫秒）
JWT_EXPIRATION=86400000

# -------- 阿里云 OSS --------
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_BUCKET=smarttourism717
OSS_DOMAIN=https://smarttourism717.oss-cn-beijing.aliyuncs.com
OSS_PUBLIC_DOMAIN=https://smarttourism717.oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# -------- 通义千问 DashScope --------
DASHSCOPE_API_KEY=

# -------- 高德地图 --------
AMAP_API_KEY=

# -------- 邮件 --------
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_AUTH_CODE=

# -------- 微信小程序 --------
WECHAT_APPID=
WECHAT_APPSECRET=

# -------- 数字人（DeepSeek / CosyVoice） --------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 数字人服务端口与 Python 预测服务端口（与 start-all.sh / application.yml 保持一致）
DIGITAL_HUMAN_PORT=8083
PREDICTION_SERVICE_PORT=8001
PREDICTION_SERVICE_URL=http://localhost:8001

# -------- Python 预测服务附加配置 --------
# 预测服务的 CORS 白名单，默认 * 允许所有来源
PREDICTION_CORS_ORIGINS=*
# 预测服务日志级别
LOG_LEVEL=INFO

# -------- 主后端迁移脚本 --------
# 若接入 Flyway（即 pom 中添加 flyway-core 后）设为 true
FLYWAY_ENABLED=false
